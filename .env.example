# Copy this file to .env, then edit the values before starting Docker Compose.
# API key used by clients to authenticate with this adapter.
API_KEY=your_secure_api_key_here

# Credentials: use a Vertex Express key, service account JSON, or JSON files
# placed in ./credentials (mounted at /app/credentials in the container).
# Multiple Express keys can be separated with commas.
VERTEX_EXPRESS_API_KEY=
VERTEX_EXPRESS_LOCATION=global

# Optional: paste complete service account JSON on one line, in single quotes.
# Separate multiple JSON objects with commas. Leave empty to use ./credentials.
GOOGLE_CREDENTIALS_JSON=

# Rotate service account credentials when multiple accounts are available.
ROUNDROBIN=false

# Optional upstream proxy. Leave empty for direct connections.
# Use an address reachable from the container; 127.0.0.1 is the container itself.
# Proxy coverage varies by endpoint; see README.md.
# PROXY_URL=http://192.168.1.100:7890
# PROXY_URL=socks5://192.168.1.100:1080
PROXY_URL=

# Simulate streaming with keep-alive events (interval in seconds).
FAKE_STREAMING=false
FAKE_STREAMING_INTERVAL=1.0
